rên thiệp thật."},"homeRsvp":{"tag":"TẠO KHÁCH \u0026 QUẢN LÝ RSVP","title1":"Biết ai sẽ đến,","title2":"tiệc cưới nhẹ tênh","description":"Gửi lời mời thật trang trọng, rồi yên tâm chuẩn bị cho ngày vui. Khỏi phải lục lại tin nhắn đếm ai đi ai không, đã có trang quản lý khách mời thông minh lo phần đó.","feature1":"Thêm từng khách hoặc thêm hàng loạt, rồi chia nhóm theo gia đình hay bàn tiệc","feature2":"Mỗi khách một link riêng, lời chào và lời mời đúng vai vế hiện trên phong bì","feature3":"Khách xác nhận có đến hay không, kèm số người và những câu bạn muốn hỏi","feature4":"Tạo link để người nhà cùng thêm khách, không cần đăng nhập","feature5":"Sửa, gộp nhóm hay xoá nhiều khách cùng lúc, xem tổng quan trong nháy mắt","ctaCreate":"Tạo thiệp cưới","ctaHint":"Tạo khách, gửi link, theo dõi RSVP trong cùng một nơi.","ctaLearnMore":"Quản lý khách mời","cardGuestLabel":"Link riêng của khách","cardGuestTitle":"Tên khách đã điền sẵn","cardReportTitle":"QUẢN LÝ KHÁCH","cardReportSubtitle":"RSVP tự gom về một nơi","cardNewReply":"Khách vừa trả lời","cardAttending":"Có đến","cardDeclined":"Không đến","cardPending":"Chưa trả lời","cardTotalLabel":"người dự tiệc đã ghi nhận","cardReplyRate":"đã trả lời","cardSummary":"{confirmed} khách đã RSVP · {total} người dự tiệc","cardQuestionGuests":"Số người đi cùng","cardQuestionShuttle":"Cần xe đưa đón?","cardQuestionMeal":"Món chay / dị ứng","cardQuestionSong":"Bài hát muốn nghe","cardGuestPrompt":"Anh Tuấn \u0026 Chị Hà sẽ đến chung vui chứ?","cardYes":"Tôi sẽ đến"},"homeTemplateSwitch":{"tag":"Đổi mẫu tự do","title1":"Đổi mẫu không cần","title2":"nhập lại thông tin","description":"Chọn mẫu khác bất cứ lúc nào. Tên cô dâu chú rể, tên bố mẹ hai bên, ngày giờ, địa điểm và ảnh cưới đều được giữ nguyên, chỉ có thiết kế thay đổi.","feature1":"Mọi thông tin đã nhập được giữ nguyên, bạn không phải gõ lại từ đầu.","feature2":"Đổi bao nhiêu lần cũng được, hoàn toàn miễn phí.","feature3":"Link thiệp đã gửi cho khách không đổi, khách vẫn xem được bản mới nhất.","ctaCreate":"Tạo thiệp miễn phí","ctaBrowse":"Xem tất cả mẫu","cardAlt":"Cùng một thiệp cưới hiển thị trên nhiều mẫu thiết kế khác nhau","dotLabel":"Xem mẫu thứ {index}"},"wwHero":{"headline":"Website cưới của bạn, chỉ trong một đường link","mobileSubtitle":"Câu chuyện, lịch trình, bản đồ địa điểm, hình ảnh và RSVP, tất cả trong một link.","desktopQuote":"Mọi thứ khách mời cần, gói gọn một nơi","desktopSubtitle":"Được tích hợp ngay trong thiệp cưới, không cần dựng thêm gì riêng.","trialInfo":"Tạo miễn phí · Thử 3 ngày · Đẹp mới thanh toán","ctaBrowse":"Xem Mẫu Thiệp","ctaCreate":"Tạo Ngay","heroAlt1":"Lịch trình và bản đồ địa điểm website cưới trên điện thoại","heroAlt2":"Xác nhận tham dự (RSVP) website cưới trên điện thoại","bannerAlt":"Website cưới có RSVP, tích hợp ngay trong thiệp cưới ChungDoi"},"wwSteps":{"heading1":"Tạo website cưới","heading2":"chỉ trong vài phút","subheading":"Chọn mẫu, điền thông tin, chia sẻ một link","stepLabel":"Bước","step1Title":"Chọn mẫu","step1Desc":"Bắt đầu từ mẫu thiệp có sẵn: màu sắc, phông chữ và từng mục đều đã sẵn sàng, không cần dựng lại từ đầu.","step1Short":"Chọn mẫu yêu thích","step2Title":"Điền thông tin","step2Desc":"Điền tên, lịch trình, địa điểm, hình ảnh và nhạc nền. Bật tắt từng mục tuỳ theo tiệc cưới của bạn.","step2Short":"Điền thông tin tiệc cưới","step3Title":"Chia sẻ một link","step3Desc":"Gửi link qua Zalo, Messenger hoặc mã QR. Khách mời mở website trên điện thoại và RSVP ngay tại đó.","step3Short":"Chia sẻ link của bạn","ctaStart":"Bắt đầu tạo","ctaGuide":"Xem hướng dẫn đầy đủ"},"wwFeature":{"tag":"TÍCH HỢP RSVP","description":"Mọi website cưới ChungDoi đều tích hợp sẵn RSVP. Không cần lục tin nhắn đếm ai đến ai không, trang quản lý khách mời cập nhật theo thời gian thực."},"wwFeaturesGrid":{"title1":"Website cưới của bạn","title2":"có những gì","subtitle":"Những mục cần thiết cho khách mời, gói gọn trong một trang"},"wwFaq":{"title":"Câu hỏi thường gặp"},"multiLang":{"title1":"Hỗ Trợ","title2":"Đa Ngôn Ngữ","description":"Thiệp cưới hiển thị song song nhiều ngôn ngữ trên cùng một thiệp. Hoàn hảo cho đám cưới có khách mời quốc tế hoặc gia đình đa văn hóa.","feature1":"Thêm ngôn ngữ chỉ với 1 click","feature2":"Nội dung hiển thị song song","feature3":"Có sẵn bản dịch mặc định","feature4":"Tuỳ chỉnh bản dịch dễ dàng","primaryGroom":"Chú Rể","primaryBride":"Cô Dâu","primaryInvite":"Trân trọng kính mời","ctaCreate":"Tạo thiệp ngay","ctaLearnMore":"Tìm hiểu thêm"},"homeVideo":{"tag":"Video thiệp cưới","title1":"Khoe thiệp lên","title2":"Story và Reels","description":"Cả tấm thiệp của hai bạn gói trong một video, để đăng lên mạng xã hội và lưu giữ dài lâu.","feature1":"Full HD sắc nét, đăng story, đăng reels hay gửi vào nhóm chat gia đình đều vừa khung.","feature2":"Nhạc, ảnh và lời mời y hệt tấm thiệp khách đang xem.","feature3":"Bấm một nút là có, không cần biết dựng video.","feature4":"Sửa thiệp xong tạo lại, lúc nào cũng là bản mới nhất.","feature5":"Tải thiệp về máy dễ dàng.","ctaCreate":"Tạo thiệp cưới","ctaLearnMore":"Cách tải video","note":"Tính năng chỉ có tại Chung Đôi, dành cho thiệp đã thanh toán","videoAlt":"Thiệp cưới chạy dạng video: phong bì mở ra rồi thiệp tự cuộn","videoPlay":"Phát video","caption":"Video dài khoảng 1 đến 2 phút, tuỳ độ dài thiệp"},"templateListing":{"title":"Mẫu thiệp mời đám cưới","subtitle":"Tạo miễn phí · Thử 3 ngày · Đẹp mới thanh toán","canSwitch":"Bạn có thể đổi mẫu bất cứ lúc nào khi chỉnh sửa","newBadge":"Mới","hotBadge":"Hot","noTemplates":"Không có mẫu nào","noTemplatesHint":"Vui lòng chọn danh mục khác","ctaReady":"Sẵn sàng tạo thiệp?","ctaSignup":"Đăng ký để tạo thiệp ngay · Dùng thử 3 ngày miễn phí","ctaSignupBtn":"Đăng ký ngay","guideLabel":"Hướng dẫn","guideTitle":"Hướng dẫn tạo thiệp từng bước","guideDesc":"Từng bước đơn giản, ai cũng làm được","guideLink":"Xem hướng dẫn","pricingLabel":"Bảng giá","pricingTitle":"Miễn phí 3 ngày","pricingDesc":"Chỉ thanh toán khi bạn hài lòng","pricingLink":"Xem bảng giá"}