yDateRequired":"Bạn chọn ngày cho buổi này nhé.","ceremonyDateInvalid":"Bạn kiểm tra lại ngày của buổi này nhé.","ceremonyTimeRequired":"Bạn thêm giờ cho buổi này nhé.","ceremonyTimeInvalid":"Giờ cần có dạng 18:30, từ 00:00 đến 23:59.","ceremonyLocationRequired":"Bạn thêm địa điểm cho buổi này nhé."}},"SalaryCalculator":{"eyebrow":"Công cụ miễn phí · Việt Nam","title":"Tính lương Gross sang Net","subtitle":"Hiểu rõ lương thực nhận với bộ quy tắc mới nhất.","scope":"Dành cho người lao động Việt Nam cư trú thuế tại Việt Nam, có lương hằng tháng và tham gia đủ BHXH, BHYT, BHTN theo mức thông thường.","scopeLink":"Xem phạm vi áp dụng","unsupported":"Ước tính cho một công việc toàn thời gian, hợp đồng từ 3 tháng, lương bằng tiền chịu thuế và giảm trừ người phụ thuộc đủ điều kiện. Chưa tính người không cư trú, chế độ bảo hiểm của người nước ngoài, nhiều nơi làm việc, thưởng, thu nhập miễn thuế, phúc lợi trả thay, giảm trừ khác hoặc quyết toán năm. Nếu thuộc các trường hợp này, hãy nhờ bộ phận nhân sự tính theo hồ sơ thực tế.","direction":"Chiều quy đổi","grossToNet":"Gross → Net","netToGross":"Net → Gross","grossInput":"Lương Gross / tháng","netInput":"Lương Net mong muốn / tháng","dependents":"Người phụ thuộc","removeDependent":"Giảm người phụ thuộc","addDependent":"Thêm người phụ thuộc","moreOptions":"Tùy chọn khác","optionsSummary":"Vùng {region} · {base}","customBase":"Mức đóng riêng","grossBase":"Đóng bảo hiểm theo lương Gross","region":"Vùng lương tối thiểu","regionOption":"Vùng {region}","regionHelp":"Chọn theo nơi làm việc của đơn vị, không theo nơi ở. Một tỉnh có thể thuộc nhiều vùng.","regionLookup":"Tra xã, phường trong phụ lục chính thức","customInsurance":"Dùng mức lương đóng bảo hiểm riêng","insuranceBase":"Lương làm căn cứ đóng bảo hiểm (VND)","baseHelp":"Nhập mức lương đóng bảo hiểm trên hợp đồng hoặc phiếu lương. Công cụ tự áp trần BHXH/BHYT và BHTN riêng; mức nhập phải từ lương tối thiểu vùng đến lương Gross.","instant":"Kết quả cập nhật khi bạn thay đổi thông tin.","privacy":"Tính ngay trên trình duyệt. Không cần tài khoản; lương không được lưu hoặc gửi đi.","results":"Kết quả tính lương","takeHome":"Lương thực nhận","employerCost":"Chi phí doanh nghiệp","grossPerMonth":"Lương Gross cần có / tháng","salaryBreakdown":"Chi tiết lương","netPerMonth":"Lương Net / tháng","costPerMonth":"Tổng lương và bảo hiểm / tháng","gross":"Lương Gross","net":"Lương Net","insurance":"Bảo hiểm bắt buộc","tax":"Thuế TNCN","social":"BHXH","health":"BHYT","unemployment":"BHTN","accident":"Tai nạn lao động","source":"Căn cứ","employerNote":"Gồm lương Gross và phần bảo hiểm thông thường của doanh nghiệp (17% BHXH + 0,5% tai nạn lao động + 3% BHYT + 1% BHTN, theo từng trần). Chưa gồm kinh phí công đoàn, phúc lợi hay ưu đãi giảm đóng.","rounding":"Làm tròn từng khoản đến đồng","emptyResult":"Nhập thông tin hợp lệ để xem kết quả.","rulesHeading":"Xem cách tính, ngày hiệu lực và nguồn chính thức","effectiveExplanation":"Biểu thuế 5 bậc và giảm trừ gia cảnh áp dụng từ kỳ tính thuế 2026, gồm cả tháng 1. Tháng 7 chỉ đổi mức lương cơ sở từ 2,34 lên 2,53 triệu đồng: trần BHXH/BHYT tăng từ 46,8 lên 50,6 triệu đồng. Thu nhập tính thuế = Gross − bảo hiểm người lao động − giảm trừ bản thân − giảm trừ người phụ thuộc, tối thiểu bằng 0. Thuế tính lần lượt trên từng phần thu nhập trong mỗi bậc.","checked":"Đối chiếu nguồn: {date}","effective":"Áp dụng cho phép tính từ {date}","personalDeduction":"Giảm trừ bản thân","dependentDeduction":"Tổng giảm trừ người phụ thuộc","taxable":"Thu nhập tính thuế","socialHealthCap":"Trần lương đóng BHXH/BHYT","unemploymentCap":"Trần lương đóng BHTN","baseSalary":"Lương cơ sở","taxTable":"Biểu thuế lũy tiến theo tháng · 2026","taxableBand":"Phần thu nhập tính thuế / tháng","rate":"Thuế suất","upTo":"Đến {amount}","between":"Trên {lower} đến {upper}","over":"Trên {amount}","errors":{"amount":"Bạn nhập số tiền nguyên dương bằng VND, tối đa 10 tỷ đồng nhé. Có thể dùng dấu chấm hoặc dấu phẩy để phân tách hàng nghìn.","month":"Vui lòng chọn một bộ quy tắc đã được kiểm chứng.","dependents":"Số người phụ thuộc cần là số nguyên từ 0 đến 20.","region":"Vui lòng chọn một trong bốn vùng lương tối thiểu.","insuranceBase":"Lương đóng bảo hiểm phải từ mức lương tối thiểu vùng đến lương Gross. Vui lòng kiểm tra lại nhé.","belowMinimum":"Lương thấp hơn mức tối thiểu của vùng đã chọn. Công cụ chưa hỗ trợ tháng làm việc không trọn vẹn hoặc công việc bán thời gian.","netRange":"Lương Net này không phù hợp với vùng, mức đóng bảo hiểm hoặc giới hạn 10 tỷ đồng Gross. Vui lòng kiểm tra lại thông tin nhé."},"ruleVersion":"Bộ quy tắc tính lương","latestVersion":"Mới nhất (từ {date})","previousVersion":"Trước đây ({from} - {to})","versionHelp":"Mặc định dùng bộ quy tắc mới nhất đã kiểm chứng. Chỉ đổi khi bạn muốn tính theo quy định trước đây.","supportedRules":"Quy tắc năm 2026 đã được kiểm chứng. Có thể chọn bộ trước đây trong Tùy chọn khác.","appliedRules":"Đang áp dụng: {version}","seeBreakdown":"Xem chi tiết","dependentAllowance":"{count} × {each} = {total} giảm trừ / tháng","allowanceHelp":"Khoản này làm giảm thu nhập tính thuế, không phải tiền cộng thêm vào lương.","taxableChange":"Thu nhập tính thuế: {before} → {after}","sameGrossComparison":"So với không có người phụ thuộc, tại cùng mức lương Gross.","alreadyTaxFree":"Ở mức Gross này, thuế TNCN đã bằng 0 dù chưa có người phụ thuộc. Vì vậy, thay đổi số người phụ thuộc không làm thay đổi kết quả lương.","taxFloor":"Thuế TNCN đã về 0. Giảm trừ thêm không thể làm thuế âm, nên thêm người phụ thuộc sẽ không làm thay đổi kết quả lương.","fixedNetExplanation":"Mức Net bạn mong muốn được giữ nguyên. Công cụ cập nhật mức Gross cần có để đạt mức Net đó.","dependentNeedsValidSalary":"Nhập mức lương hợp lệ để xem khoản giảm trừ và tác động đến thuế.","beforeTax":"Cách tính thu nhập tính thuế","taxableFormula":"Gross − bảo hiểm người lao động − giảm trừ bản thân − giảm trừ người phụ thuộc. Thấp nhất bằng 0; các khoản giảm trừ không bị trừ vào lương thực nhận.","taxSavingShort":"Tổng thuế TNCN giảm"}},"now":"$undefined","timeZone":"Asia/Ho_Chi_Minh","children":"$L38"}]\n',
