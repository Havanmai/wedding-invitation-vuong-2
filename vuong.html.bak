      }
      .animate-dance-2 {
        animation: dance.4s ease-in-out infinite.1s;
      }
      .animate-dance-3 {
        animation: dance.4s ease-in-out infinite.2s;
      }
      .animate-dance-4 {
        animation: dance.4s ease-in-out infinite.3s;
      }
      @keyframes bounce-gentle {
        0%,
        100% {
          transform: translatey(0);
        }
        50% {
          transform: translatey(-8px);
        }
